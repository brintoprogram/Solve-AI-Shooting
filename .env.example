# ─────────────────────────────────────────────
# Solve AI Shooting — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# ─────────────────────────────────────────────

# ── Supabase (frontend) ──────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Domínio da aplicação ─────────────────────
VITE_APP_DOMAIN=https://your-app-domain.com

# ── Meta / WhatsApp ──────────────────────────
# IDs opcionais pré-configurados (normalmente gerenciados pela UI)
VITE_META_APP_ID=your-meta-app-id
VITE_META_CONFIG_ID=your-meta-config-id

# ─────────────────────────────────────────────
# Supabase Edge Functions — configurar via:
#   supabase secrets set NOME=valor
# Não usar .env para Edge Functions em produção.
# ─────────────────────────────────────────────

# ── Criptografia (AES-256-GCM) ───────────────
# 64 caracteres hexadecimais = 32 bytes
# Gerar: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# ── N8N ─────────────────────────────────────
# URL completa do webhook de disparo de email no n8n
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-uuid-here

# ── CORS ─────────────────────────────────────
# Lista de origens permitidas, separadas por vírgula.
# Use * para permitir qualquer origem (não recomendado em produção).
# Suporte a wildcard de subdomínio: https://*.vercel.app
ALLOWED_ORIGINS=https://your-app-domain.com,http://localhost:5173

# ── Chatwoot (proxy de webhook — se aplicável) ──
CHATWOOT_VERIFY_TOKEN=your-chatwoot-verify-token-here
CHATWOOT_URL=https://your-chatwoot-instance.com/webhooks/whatsapp/your-number

# ── Outros segredos (configurados via Supabase Secrets) ──────────
# ANTHROPIC_API_KEY     → chave da API Anthropic (configurada pela UI de Settings)
# OPENAI_API_KEY        → chave da API OpenAI (configurada pela UI de Settings)
# SUPABASE_SERVICE_ROLE_KEY → gerada automaticamente pelo Supabase
# SUPABASE_DB_URL           → gerada automaticamente pelo Supabase
